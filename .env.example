# Supabase Postgres: pooled (transaction mode, port 6543) for runtime
DATABASE_URL=
# Supabase direct/session connection (port 5432) for migrations
DATABASE_URL_DIRECT=

# GitHub token (no scopes needed for public repos)
GITHUB_TOKEN=

# Google AI Studio
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_PLAN_MODEL=gemini-3.1-flash-lite
GEMINI_EMBED_MODEL=gemini-embedding-001

# Inngest Cloud
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Random string (>=16 chars); also used as the better-auth secret
SESSION_SECRET=

# GitHub OAuth App (callback: <BETTER_AUTH_URL>/api/auth/callback/github)
BETTER_AUTH_URL=http://localhost:3000
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# "repo" is required to document private repositories
GITHUB_OAUTH_SCOPES=read:user,user:email,repo
