# Supabase Postgres: pooled (transaction mode, port 6543) for runtime
DATABASE_URL=
# Supabase direct/session connection (port 5432) for migrations
DATABASE_URL_DIRECT=

# GitHub token (no scopes needed for public repos)
GITHUB_TOKEN=

# Google AI Studio
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_PLAN_MODEL=gemini-3.1-flash-lite
GEMINI_EMBED_MODEL=gemini-embedding-001

# Inngest Cloud
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Random string (>=16 chars) used to sign the anonymous session cookie
SESSION_SECRET=
