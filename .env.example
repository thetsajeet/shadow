# Supabase Postgres: pooled (transaction mode, port 6543) for runtime
DATABASE_URL=
# Supabase direct/session connection (port 5432) for migrations
DATABASE_URL_DIRECT=

# GitHub token (no scopes needed for public repos)
GITHUB_TOKEN=

# Google AI Studio
MODEL_PROVIDER=google
EMBEDDING_PROVIDER=google
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# GEMINI_PLAN_MODEL defaults to GEMINI_MODEL when unset
# GEMINI_PLAN_MODEL=
GEMINI_EMBED_MODEL=gemini-embedding-001
# Set MODEL_PROVIDER=openai and provide OPENAI_API_KEY to use OpenAI instead.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_EMBED_MODEL=text-embedding-3-small

# Optional error monitoring (Sentry)
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=

# Cloudflare Turnstile keys. Required in production for generation and chat.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# Abuse controls and retention (defaults shown)
GENERATION_ENABLED=true
MAX_GENERATION_TOKENS=200000
DAILY_TOKEN_BUDGET=1000000
RATE_LIMIT_GENERATION_PER_IP=10
RATE_LIMIT_CHAT_PER_IP=30
RATE_LIMIT_WINDOW_SECONDS=3600
DATA_RETENTION_DAYS=90

# Inngest Cloud (not needed with the local Dev Server: `docker compose up`, set INNGEST_DEV=1)
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

SESSION_SECRET=

# GitHub OAuth App (callback: <BETTER_AUTH_URL>/api/auth/callback/github)
BETTER_AUTH_URL=http://localhost:3000
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# "repo" is required to document private repositories
GITHUB_OAUTH_SCOPES=read:user,user:email,repo
